# Screenshot Knowledge Base — Environment Configuration
# Copy this file to .env and edit as needed.
# Most users don't need to change anything — defaults work out of the box.

# ── Screenshot source ──────────────────────────────────────────────────────
# Default folder scanned by the pipeline.
# Override with --source flag on the CLI, or set here to avoid typing it every time.
# SOURCE_DIR=C:\Users\YourName\Pictures\Screenshots

# ── API server ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── OCR settings ───────────────────────────────────────────────────────────
# Language for PaddleOCR. Options: en, ch, hi, fr, de, ja, ko, ...
PADDLE_LANG=en

# Confidence threshold (0-100). Below this, Tesseract fallback is tried.
OCR_CONFIDENCE_THRESHOLD=50

# ── CLIP model ─────────────────────────────────────────────────────────────
# Model used for semantic search and zero-shot classification.
# Smaller = faster. Larger = more accurate.
# Options: clip-ViT-B-32 (default, 350MB), clip-ViT-L-14 (900MB)
CLIP_MODEL=clip-ViT-B-32

